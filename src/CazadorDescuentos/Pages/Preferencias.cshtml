@page
@model PreferenciasModel
@{
    ViewData["Title"] = "Preferencias";
}

<h1 class="h3">¿Qué te gusta comer?</h1>
<p class="text-muted">Elegí hasta 3 categorías y vas a ver primero sus ofertas. Se guarda en este dispositivo, sin crear cuenta.</p>

<form method="post" id="form-preferencias">
    <div class="d-flex flex-wrap gap-2 mb-2">
        @foreach (var categoria in Model.Categorias)
        {
            <input class="btn-check" type="checkbox" name="Seleccionadas" value="@categoria" id="cat-@categoria"
                   autocomplete="off" checked="@Model.Seleccionadas.Contains(categoria)" />
            <label class="btn btn-outline-primary rounded-pill" for="cat-@categoria">@categoria</label>
        }
    </div>
    <p class="small text-muted" id="contador-preferencias" aria-live="polite"></p>
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Guardar y ver ofertas</button>
        <a asp-page="/Index" class="btn btn-link">Omitir</a>
    </div>
</form>

@section Scripts {
    <script>
        // Bloquea más de 3 selecciones (el servidor también lo valida).
        (function () {
            const maximo = @Model.Maximo;
            const casillas = Array.from(document.querySelectorAll("#form-preferencias input[type=checkbox]"));
            const contador = document.getElementById("contador-preferencias");
            function actualizar() {
                const marcadas = casillas.filter(c => c.checked).length;
                casillas.forEach(c => c.disabled = !c.checked && marcadas >= maximo);
                contador.textContent = `${marcadas} de ${maximo} seleccionadas`;
            }
            casillas.forEach(c => c.addEventListener("change", actualizar));
            actualizar();
        })();
    </script>
}
