@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="estado-vacio">
    <span class="estado-vacio-icono" aria-hidden="true">😕</span>
    <h1 class="h4">Algo salió mal</h1>
    <p class="text-body-secondary">No es tu culpa. Volvé a intentar en unos segundos; si sigue pasando, probá más tarde.</p>
    <a asp-page="/Index" class="btn btn-primary">Volver a las ofertas</a>

    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary mt-3 mb-0">Si nos escribís, mencioná este código: <code>@Model.RequestId</code></p>
    }
</div>
