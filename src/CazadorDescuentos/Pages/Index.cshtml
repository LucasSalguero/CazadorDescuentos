@page
@model IndexModel
@{
    ViewData["Title"] = "Ofertas";
}

<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-2">
    <h1 class="h3 mb-0">Ofertas de hoy</h1>
    <span class="text-muted small">@Model.Ofertas.Count @(Model.Ofertas.Count == 1 ? "oferta activa" : "ofertas activas")</span>
</div>

@if (Model.Preferencias.Count == 0)
{
    <div class="alert alert-light border small py-2">
        ¿Qué tenés ganas de comer? <a asp-page="/Preferencias">Elegí hasta 3 categorías</a> y te mostramos esas ofertas primero.
    </div>
}
else
{
    <p class="small text-muted mb-2">
        Primero: @string.Join(", ", Model.Preferencias) · <a asp-page="/Preferencias">cambiar</a>
    </p>
}

<form method="get" class="filtros row g-2 mb-3" aria-label="Filtros">
    <div class="col-6 col-md-4">
        <label for="Marca" class="visually-hidden">Marca</label>
        <select asp-for="Marca" asp-items="@(new SelectList(Model.Marcas))" class="form-select" onchange="this.form.requestSubmit()">
            <option value="">Todas las marcas</option>
        </select>
    </div>
    <div class="col-6 col-md-4">
        <label for="Categoria" class="visually-hidden">Categoría</label>
        <select asp-for="Categoria" asp-items="@(new SelectList(Model.Categorias))" class="form-select" onchange="this.form.requestSubmit()">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-12 col-md-4 d-flex gap-2">
        <noscript><button type="submit" class="btn btn-primary">Filtrar</button></noscript>
        @if (Model.HayFiltros)
        {
            <a asp-page="/Index" class="btn btn-outline-secondary w-100">Quitar filtros</a>
        }
    </div>
</form>

@if (Model.Ofertas.Count == 0)
{
    <div class="text-center text-muted py-5">
        <p class="mb-2">No hay ofertas activas@(Model.HayFiltros ? " con esos filtros" : "") por ahora.</p>
        @if (Model.HayFiltros)
        {
            <a asp-page="/Index">Ver todas las ofertas</a>
        }
    </div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    @foreach (var item in Model.Ofertas)
    {
        var o = item.Oferta;
        <div class="col">
            <article class="card oferta h-100 @Formato.ClaseMarca(o.Marca)">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <span class="marca-chip">@o.Marca</span>
                        @if (o.PorcentajeDescuento > 0)
                        {
                            <span class="descuento">-@Formato.Porcentaje(o.PorcentajeDescuento)</span>
                        }
                    </div>
                    <h2 class="h6 card-title mb-1">
                        <a asp-page="/Ofertas/Detalle" asp-route-id="@o.Id" class="stretched-link text-reset text-decoration-none">@o.Producto</a>
                    </h2>
                    <div class="mb-2">
                        <span class="precio">@Formato.Pesos(o.PrecioPromocional)</span>
                        @if (o.PrecioOriginal > o.PrecioPromocional)
                        {
                            <s class="text-muted small ms-1">@Formato.Pesos(o.PrecioOriginal)</s>
                        }
                    </div>
                    <div class="mt-auto d-flex flex-wrap gap-1 small">
                        <span class="badge text-bg-light border">@o.Categoria</span>
                        <span class="badge text-bg-light border">@Formato.Vence(o.VencimientoUtc, Model.AhoraUtc)</span>
                        @if (o.Codigo is not null)
                        {
                            <span class="badge text-bg-light border">Con código</span>
                        }
                    </div>
                    @if (item.Etiqueta is not null)
                    {
                        <div class="etiqueta-preferencia mt-2">@item.Etiqueta</div>
                    }
                </div>
            </article>
        </div>
    }
</div>
