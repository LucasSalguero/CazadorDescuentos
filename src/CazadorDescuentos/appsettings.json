{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CazadorDescuentos": "Data Source=cazadordescuentos.db"
  },
  "Ingesta": {
    // La clave del LLM y la API key de carga manual NO van en este archivo.
    // Desarrollo: dotnet user-secrets set "Ingesta:LlmApiKey" "<clave>"
    //             dotnet user-secrets set "Ingesta:CargaManualApiKey" "<clave>"
    // Producción: variables de entorno Ingesta__LlmApiKey e Ingesta__CargaManualApiKey.
    "Marcas": [
      { "Nombre": "Mostaza", "Url": "https://mostazaweb.com.ar/" },
      { "Nombre": "McDonald's", "Url": "https://www.mcdonalds.com.ar/" },
      { "Nombre": "Burger King", "Url": "https://www.burgerking.com.ar/" }
    ],
    // API compatible con OpenAI Chat Completions (OpenAI, Groq, OpenRouter, Gemini, etc.).
    "LlmUrl": "https://api.openai.com/v1/chat/completions",
    "LlmModelo": "gpt-4o-mini",
    // En Development se cargan ofertas de ejemplo para poder ver el frontend sin LLM.
    "CargarDatosDemo": false
  },
  "Semaforo": {
    "MinimoVotos": 3,
    "PorcentajeVerde": 70,
    "PorcentajeRojo": 40
  }
}
