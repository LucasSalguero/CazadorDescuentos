{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CazadorDescuentos": "Data Source=cazadordescuentos.db"
  },
  "Ingesta": {
    // La clave del LLM y la API key de carga manual NO van en este archivo.
    // Desarrollo: dotnet user-secrets set "Ingesta:LlmApiKey" "<clave>"
    //             dotnet user-secrets set "Ingesta:CargaManualApiKey" "<clave>"
    // Producción: variables de entorno Ingesta__LlmApiKey e Ingesta__CargaManualApiKey.
    "Marcas": [
      { "Nombre": "MarcaEjemplo1", "Url": "https://ejemplo.com/marca1/promociones" },
      { "Nombre": "MarcaEjemplo2", "Url": "https://ejemplo.com/marca2/promociones" },
      { "Nombre": "MarcaEjemplo3", "Url": "https://ejemplo.com/marca3/promociones" }
    ]
  },
  "Semaforo": {
    "MinimoVotos": 3,
    "PorcentajeVerde": 70,
    "PorcentajeRojo": 40
  }
}
